#!/usr/bin/env bash
set -euo pipefail

MARK_DIR="/home/lorenzomccray/Cline/.cortex/.hooks/runtime-test"
mkdir -p "$MARK_DIR"

TS="$(date +%Y%m%d-%H%M%S)"
INFILE="$MARK_DIR/taskstart-${TS}.stdin.json"
OUTFILE="$MARK_DIR/taskstart-${TS}.marker.json"

INPUT="$(cat || true)"
printf '%s\n' "$INPUT" > "$INFILE"

python3 - <<'PY'
import json, pathlib, datetime, os

mark_dir = pathlib.Path("/home/lorenzomccray/Cline/.cortex/.hooks/runtime-test")
stdin_files = sorted(mark_dir.glob("taskstart-*.stdin.json"))
latest = stdin_files[-1] if stdin_files else None

payload = {
    "hook": "TaskStart",
    "timestamp": datetime.datetime.now(datetime.UTC).isoformat().replace("+00:00", "Z"),
    "pid": os.getpid(),
    "cwd": os.getcwd(),
    "stdin_file": str(latest) if latest else None
}

if latest:
    out_path = latest.with_name(latest.name.replace(".stdin.json", ".marker.json"))
else:
    out_path = mark_dir / "taskstart-fallback.marker.json"

out_path.write_text(json.dumps(payload, indent=2) + "\n")
PY

printf '%s\n' '{"cancel":false,"contextModification":"","errorMessage":""}'
